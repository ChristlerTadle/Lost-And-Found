{
  "name": "buksu-lost-and-found",
  "version": "1.0.0",
  "private": true,
  "description": "BukSU Lost and Found application using Node.js, Express, and MongoDB",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "start:frontend": "node frontend/server.js",
    "dev:frontend": "node --watch frontend/server.js",
    "migrate:role-permissions": "node scripts/migrate-role-permissions.js",
    "migrate:general-audit-log": "node scripts/migrate-general-audit-log.js",
    "migrate:integrations": "node scripts/migrate-integration-settings.js",
    "seed:admin": "node scripts/seed-admin.js",
    "test": "node --test backend/tests/api.test.js backend/tests/role-permissions.test.js backend/tests/audit-log.test.js backend/tests/audit-actions.test.js backend/tests/audit-migration.test.js backend/tests/recaptcha.test.js backend/tests/integration-settings.test.js",
    "test:found-submit": "node scripts/test-found-submit.js",
    "test:notifications": "node scripts/test-notifications.js",
    "test:password-reset": "node scripts/test-password-reset.js",
    "test:google-auth": "node scripts/test-google-auth.js",
    "test:staff-login": "node scripts/test-staff-login.js",
    "test:staff-item-service": "node scripts/test-staff-item-service.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "google-auth-library": "^11.3.1",
    "mongodb": "^6.17.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.1"
  }
}
