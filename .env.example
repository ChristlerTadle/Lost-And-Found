PORT=3000
# Local-development example only; replace with a unique random secret before deployment.
SESSION_SECRET=local-dev-only-change-before-deploying-7c21d99e1a2f4b2c8f5a0d3e6b9c1a4f
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=lost_and_found
APP_BASE_URL=http://localhost:3000

# Optional: enter the OAuth client ID and secret from your Google Cloud project to enable Google sign-in.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Optional: configure these with the SMTP account used to send password-reset emails.
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=BukSU Lost and Found <your-email@gmail.com>

MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DATABASE=lost_and_found
MYSQL_SOURCE_USER=root
MYSQL_SOURCE_PASSWORD=your-local-mysql-password
