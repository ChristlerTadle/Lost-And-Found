# Local-development example only; replace with a unique random secret before deployment.
SESSION_SECRET=local-dev-only-change-before-deploying-7c21d99e1a2f4b2c8f5a0d3e6b9c1a4f
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=lost_and_found
# Dedicated database required by the real-MongoDB lock test suite; keep separate from MONGODB_DATABASE.
MONGODB_TEST_URI=
MONGODB_TEST_DATABASE=
# Lock defaults; leave LOCK_DEMO_HOLD_MS at 0 outside local demos.
LOCK_LEASE_MS=30000
LOCK_WAIT_MS=3000
LOCK_RETRY_MIN_MS=20
LOCK_RETRY_MAX_MS=120
LOCK_MAX_PER_REQUEST=5
LOCK_DEMO_HOLD_MS=0
# Keep false for direct connections; use trusted proxy hops or CIDRs only behind a proxy.
TRUST_PROXY=false

# Only set when running behind trusted proxies; use false, a hop count, or CIDRs.
TRUST_PROXY=false

# Required: base64-encoded 32-byte key used to encrypt integration secrets.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# Emergency-only: bypass admin MFA at login. Keep false except during recovery.
ADMIN_MFA_DISABLED=false

# Local testing only: disable MFA attempt limits; ignored when NODE_ENV=production.
ADMIN_MFA_RATE_LIMIT_DISABLED=false

# Required only to unlock Admin > Settings > Integrations. Leave blank until set securely.
SU_PIN=
SU_EMAIL=

# Verification-code request throttling (defaults: 5 requests per 3600 seconds,
# with a 60-second minimum between sends). For local testing, try 20, 60, and 1;
# restore the defaults before deploying.
SU_CODE_REQUEST_LIMIT=5
SU_CODE_REQUEST_WINDOW_SECONDS=3600
SU_CODE_RESEND_SECONDS=60

# Independent SMTP account for integration verification and restore notices.
# Copy the matching values from SMTP_HOST, SMTP_PORT, SMTP_SECURE,
# SMTP_USER, SMTP_PASSWORD, and SMTP_FROM. Do not remove the old SMTP_*
# values until the new verification and notification emails are confirmed.
SU_SMTP_HOST=
SU_SMTP_PORT=
SU_SMTP_SECURE=
SU_SMTP_USER=
SU_SMTP_PASSWORD=
SU_SMTP_FROM=

# Optional: enter the OAuth client ID and secret from your Google Cloud project to enable Google sign-in.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Register this API callback in Google Cloud Console as an authorized redirect URI.
# GOOGLE_REDIRECT_URI is also accepted for compatibility with existing .env files.
API_GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Optional: configure Google reCAPTCHA v2 checkbox keys to protect sign-in and registration.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Local development only: permit Google's public reCAPTCHA test keys.
RECAPTCHA_ALLOW_TEST_KEYS=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Optional: configure these with the SMTP account used to send password-reset emails.
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=BukSU Lost and Found <your-email@gmail.com>
