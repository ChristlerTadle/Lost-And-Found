<main class="container dashboard-page">
	<header class="page-header"><div><h1>My Dashboard</h1><p>Welcome back, <%= user.full_name %>. Here's your overview.</p></div><div class="head-actions"><a class="btn btn-outline" href="/index.php?page=report">Report lost</a><a class="btn btn-primary" href="/index.php?page=report&amp;kind=found">Report found</a></div></header>
	<div class="dashboard-stats">
		<a class="card dashboard-stat" href="/index.php?page=reports"><span class="dashboard-stat-icon lost"><%- icon('alert', 17) %></span><span><span class="stat-label">My lost reports</span><strong><%= lostCount %></strong><small>View my reports</small></span></a>
		<a class="card dashboard-stat" href="/index.php?page=reports"><span class="dashboard-stat-icon found"><%- icon('check', 17) %></span><span><span class="stat-label">Found reports</span><strong><%= foundCount %></strong><small>Submitted by me</small></span></a>
		<a class="card dashboard-stat" href="/index.php?page=items&amp;status_tab=stored"><span class="dashboard-stat-icon found"><%- icon('clipboard', 17) %></span><span><span class="stat-label">Stored items</span><strong><%= storedCount %></strong><small>Currently in staff custody</small></span></a>
		<a class="card dashboard-stat" href="/index.php?page=claims"><span class="dashboard-stat-icon claim"><%- icon('clipboard', 17) %></span><span><span class="stat-label">My claims</span><strong><%= claims.length %></strong><small><%= pendingClaims %> pending</small></span></a>
	</div>
	<div class="dashboard-grid"><section class="card dashboard-panel"><div class="dashboard-panel-head"><h3>Recent activity</h3><a class="link-sm" href="/index.php?page=reports">View reports</a></div><div class="dashboard-activity"><% if (!activity.length) { %><p class="empty">No activity yet.</p><% } %><% activity.forEach((entry) => { %><div class="dashboard-activity-row"><span class="dashboard-activity-icon <%= entry.type %>"><%- icon(entry.type === 'claim' ? 'clipboard' : (entry.type === 'found' ? 'check' : 'alert'), 15) %></span><div><strong><%= entry.label %></strong><span><%= entry.name %></span></div><time datetime="<%= entry.date %>"><%= formatDate(entry.date) %></time></div><% }); %></div></section><aside class="dashboard-side"><section class="card dashboard-panel"><div class="dashboard-panel-head"><h3>Quick actions</h3></div><div class="quick-actions"><a class="quick" href="/index.php?page=items"><%- icon('file', 16) %>Browse lost &amp; found items</a><a class="quick" href="/index.php?page=claims"><%- icon('clipboard', 16) %>Check my claims</a><a class="quick" href="/index.php?page=reports"><%- icon('file', 16) %>Manage my reports</a></div></section></aside></div>
</main>
