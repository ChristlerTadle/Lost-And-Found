<main class="auth">
	<section class="auth-side"><span class="auth-circle auth-circle-one"></span><span class="auth-circle auth-circle-two"></span><span class="auth-circle auth-circle-three"></span><div><a class="brand" href="/"><span class="brand-mark"><%- icon('shield', 24) %></span><span><span class="brand-name">BukSU</span><span class="brand-caption">Lost &amp; Found System</span></span></a><h1 class="display">Helping you reunite with your belongings.</h1><p class="lead">Bukidnon State University's official platform for reporting, tracking, and recovering lost and found items on campus.</p></div><p class="copyright">Supreme Student Council</p></section>
	<section class="auth-main"><div class="auth-box"><div class="auth-mobile-brand brand"><span class="brand-mark"><%- icon('shield', 20) %></span><span><span class="brand-name">BukSU</span><span class="brand-caption">Lost &amp; Found System</span></span></div><h2><%= showForgot ? 'Forgot your password?' : showReset ? 'Set a new password' : showRegister ? 'Create your account' : 'Welcome back' %></h2><p class="sub"><%= showForgot ? 'Enter your account email and we will send you a password reset link.' : showReset ? 'Choose a new password for your account.' : showRegister ? 'Register your BukSU account to report and track lost or found items.' : 'Sign in with your student or staff account to access your role-specific workspace.' %></p>
		<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
		<% if (typeof googleError !== 'undefined' && googleError) { %><div class="alert alert-error"><%= googleError %></div><% } %>
		<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
		<% if (showForgot) { %>
		<div class="card card-pad-lg"><form method="post" action="/index.php?page=forgot-password" class="form-grid"><div class="field"><label for="forgot_email">Email address</label><input class="input" id="forgot_email" name="email" type="email" autocomplete="email" required></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Send reset link</button></div></form></div>
		<p class="auth-switch"><a href="/index.php?page=login">Back to sign in</a></p>
		<% } else if (showReset) { %>
		<% if (validToken) { %><div class="card card-pad-lg"><form method="post" action="/index.php?page=reset-password" class="form-grid"><input type="hidden" name="token" value="<%= token %>"><div class="field"><label for="reset_password">New password</label><input class="input" id="reset_password" name="password" type="password" minlength="8" autocomplete="new-password" required></div><div class="field"><label for="password_confirmation">Confirm new password</label><input class="input" id="password_confirmation" name="password_confirmation" type="password" minlength="8" autocomplete="new-password" required></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Reset password</button></div></form></div><% } %>
		<p class="auth-switch"><a href="/index.php?page=login">Back to sign in</a> · <a href="/index.php?page=forgot-password">Request another link</a></p>
		<% } else { %>
		<nav class="tabs" aria-label="Account access"><a href="/index.php?page=login" data-tab="login" class="<%= !showRegister ? 'active' : '' %>">Sign in</a><a href="/index.php?page=login&amp;tab=register" data-tab="register" class="<%= showRegister ? 'active' : '' %>">Create account</a></nav>
		<div class="card card-pad-lg" data-panel="login" <%= showRegister ? 'hidden' : '' %>><form method="post" action="/index.php?page=login" class="form-grid"><input type="hidden" name="action" value="login"><div class="field"><label for="email">Email address</label><input class="input" id="email" name="email" type="email" autocomplete="email" required></div><div class="field"><label for="password">Password</label><input class="input" id="password" name="password" type="password" autocomplete="current-password" required></div><div class="auth-forgot"><a href="/index.php?page=forgot-password">Forgot password?</a></div><% if (typeof googleAuthEnabled !== 'undefined' && googleAuthEnabled) { %><div class="auth-divider"><span>or</span></div><a class="btn btn-google btn-block" href="/auth/google"><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.76 7.18l7.73 6C44.42 37.98 46.98 31.84 46.98 24.55z"/><path fill="#FBBC05" d="M10.53 28.59a14.4 14.4 0 0 1 0-9.18l-7.98-6.19a24 24 0 0 0 0 21.56l7.98-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.91-5.8l-7.73-6c-2.15 1.45-4.92 2.3-8.18 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>Continue with Google</a><% } %><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Sign in</button></div></form></div>
		<div class="card card-pad-lg" data-panel="register" <%= !showRegister ? 'hidden' : '' %>><form method="post" action="/index.php?page=login" class="form-grid"><input type="hidden" name="action" value="register"><div class="field"><label for="full_name">Full name</label><input class="input" id="full_name" name="full_name" required></div><div class="field"><label for="register_email">Email address</label><input class="input" id="register_email" name="email" type="email" required></div><div class="field"><label for="student_id">Student ID</label><input class="input" id="student_id" name="student_id" required></div><div class="field"><label for="phone">Phone number</label><input class="input" id="phone" name="phone" required></div><div class="field"><label for="register_password">Password</label><input class="input" id="register_password" name="password" type="password" minlength="8" required></div><div class="form-actions"><button class="btn btn-primary btn-block" type="submit">Create account</button></div></form></div>
		<p class="auth-switch"><%= showRegister ? 'Already have an account?' : 'Need an account?' %> <a href="/index.php?page=login&amp;tab=<%= showRegister ? 'login' : 'register' %>" data-tab="<%= showRegister ? 'login' : 'register' %>"><%= showRegister ? 'Sign in' : 'Register here' %></a></p>
		<% } %></div></section>
</main>
