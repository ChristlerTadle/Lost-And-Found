<main class="container staff-workspace admin-items-page">
	<header class="page-header browse-header">
		<div><h1>All Items</h1><p><%= items.length %> item records found</p></div>
		<a class="button button-secondary" href="/index.php?page=admin-dashboard">Admin dashboard</a>
	</header>
	<form method="get" action="/index.php" class="browse-filter-form">
		<input type="hidden" name="page" value="admin-items">
		<div class="card browse-toolbar">
			<label class="browse-search" for="admin-items-search">
				<%- icon('search', 17) %>
				<input id="admin-items-search" name="query" value="<%= filters.query %>" placeholder="Search item, description, location, reporter...">
			</label>
			<select class="select" id="admin-items-type" name="item_type" aria-label="Filter by item type">
				<option value="">All Types</option>
				<option value="lost" <%= filters.item_type === 'lost' ? 'selected' : '' %>>Lost</option>
				<option value="found" <%= filters.item_type === 'found' ? 'selected' : '' %>>Found</option>
			</select>
			<select class="select" id="admin-items-category" name="category" aria-label="Filter by category">
				<option value="">All Categories</option>
				<% categories.forEach((category) => { %><option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option><% }); %>
			</select>
			<select class="select" id="admin-items-status" name="status" aria-label="Filter by status">
				<option value="">All Statuses</option>
				<% for (const status of ['lost', 'found', 'stored', 'claimed', 'returned', 'cancelled']) { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status === 'returned' ? 'Returned to owner' : status[0].toUpperCase() + status.slice(1) %></option><% } %>
			</select>
			<button class="button button-primary browse-search-submit" type="submit">Search</button>
		</div>
		<details class="browse-more-filters">
			<summary>Filter by date</summary>
			<div class="browse-more-grid">
				<div class="form-field"><label for="admin-items-date-from">From date</label><input class="input" id="admin-items-date-from" name="date_from" type="date" value="<%= filters.date_from %>"></div>
				<div class="form-field"><label for="admin-items-date-to">To date</label><input class="input" id="admin-items-date-to" name="date_to" type="date" value="<%= filters.date_to %>"></div>
				<div class="browse-more-actions">
					<button class="button button-primary" type="submit">Apply filters</button>
					<a class="button button-secondary" href="/index.php?page=admin-items">Clear filters</a>
				</div>
			</div>
		</details>
	</form>
	<section class="card staff-record-list">
		<div class="staff-list-heading"><h2>Item records</h2><span><%= items.length %> items</span></div>
		<% if (!items.length) { %><p class="empty">No item records match these filters.</p><% } %>
		<% items.forEach((item) => { %>
			<article class="report staff-record">
				<div class="staff-record-info">
					<h2><%= item.item_name %></h2>
					<p><%= item.item_type[0].toUpperCase() + item.item_type.slice(1) %> report · <%= item.category %> · <%= item.location %></p>
					<p>Reported by <%= item.reported_by %> · <%= formatDate(item.created_at, 'M j, Y') %></p>
					<p><%= item.description %></p>
				</div>
				<span class="badge badge-<%= item.status === 'returned' || item.status === 'stored' ? 'active' : item.status === 'claimed' ? 'claimed' : item.status === 'cancelled' ? 'cancelled' : 'pending' %>"><%= item.status === 'returned' ? 'Returned to owner' : item.status[0].toUpperCase() + item.status.slice(1) %></span>
				<a class="button button-outline" href="/index.php?page=admin-edit-item&amp;id=<%= encodeURIComponent(item.id) %>">Edit record</a>
			</article>
		<% }); %>
	</section>
</main>
